# Copy this file to ".env" and fill in the values before running the app.

# Which AI backend to use: "gemini" (free), "openrouter" (free models, good fallback),
# "anthropic" (cheap paid), or "ollama" (local/free)
LLM_PROVIDER=gemini

# --- Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey  (no credit card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (free-tier models, recommended fallback if Gemini gives trouble) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Anthropic (Claude API, pay-as-you-go, optional alternative) ---
# Get a key at https://console.anthropic.com — note this is a separate,
# usage-billed API account, different from a Claude.ai Pro subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (fully local, fully free, optional alternative for offline demos) ---
# Install from https://ollama.com, then run: ollama pull llama3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Flask ---
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=true
PORT=5000
